{
  "id": "root",
  "type": "row",
  "theme": "solarized-dark",
  "titlebar": "none",
  "traffic_lights": [
    -100,
    -100
  ],
  "background": "canvas",
  "font": "Monaco",
  "font_size": 12,
  "terminal_opacity": 0.85,
  "terminal_padding": [
    4,
    4
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 32
      },
      "min": 32,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "number-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "number-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 0,
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 0,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane-footer"
                    },
                    "height": 26,
                    "position": "bottom",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "bottom-bar",
          "type": "row",
          "size": {
            "px": 26
          },
          "resizable": false,
          "window_drag": true,
          "background": "chrome",
          "children": [
            {
              "id": "status",
              "type": "block",
              "size": {
                "px": 180
              },
              "content": {
                "mod": "tmux-status"
              }
            },
            {
              "id": "tabs",
              "type": "block",
              "min": 180,
              "content": {
                "mod": "tmux-tabs",
                "props": {
                  "mode": "tabs"
                }
              }
            },
            {
              "id": "funzzy-status",
              "type": "block",
              "size": {
                "px": 160
              },
              "content": {
                "mod": "funzzy-status",
                "props": {
                  "binary": "~/.cargo/bin/fzz"
                }
              }
            },
            {
              "id": "panel-buttons",
              "type": "block",
              "size": {
                "px": 144
              },
              "content": {
                "mod": "tmux-tabs",
                "props": {
                  "mode": "panels"
                }
              }
            },
            {
              "id": "clock",
              "type": "block",
              "size": {
                "px": 150
              },
              "content": {
                "mod": "tmux-status",
                "props": {
                  "mode": "clock"
                }
              }
            }
          ]
        },
        {
          "id": "intray-observer",
          "type": "block",
          "size": {
            "px": 1
          },
          "content": {
            "mod": "intray",
            "props": {
              "mode": "observer"
            }
          }
        },
        {
          "id": "tmux-compat",
          "type": "block",
          "size": {
            "px": 1
          },
          "content": {
            "mod": "tmux-compat"
          }
        }
      ]
    }
  ],
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  }
}
